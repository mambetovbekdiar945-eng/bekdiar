<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_detail">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/backButton" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="Назад" android:padding="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/favoriteButton" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_star_outline" android:contentDescription="В избранное" android:padding="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingBottom="18dp">
        <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_poster"><TextView android:id="@+id/detailPosterInitial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="MF" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="17sp"/></FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Once Upon a Time in Hollywood" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold"/>
            <TextView android:id="@+id/detailDirector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="by Quentin Tarantino" android:textColor="#EFFFFFFF" android:textSize="12sp" android:layout_marginTop="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/playerContainer" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:background="#3320182A">
        <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:useController="true"/>
        <LinearLayout android:id="@+id/trailerOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="#6620182A" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_play" android:contentDescription="Воспроизвести трейлер"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Watch trailer" android:textColor="#FFFFFFFF" android:textSize="14sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Overview" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star" android:contentDescription="Рейтинг"/>
            <TextView android:id="@+id/detailRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9.4" android:textColor="#FFFFFFFF" android:textSize="15sp" android:layout_marginStart="5dp"/>
        </LinearLayout>
        <TextView android:id="@+id/detailOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F4EAF5" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:maxLines="4" android:text="A movie overview will appear here."/>
        <TextView android:id="@+id/readMoreButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="read all" android:textColor="#FFE6A0" android:textStyle="bold" android:paddingTop="8dp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="16dp" android:paddingStart="22dp" android:paddingEnd="22dp" android:background="#22FFFFFF">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actors" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="12dp"><LinearLayout android:id="@+id/actorsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMDb" android:textColor="#F4EAF5" android:textSize="12sp"/><TextView android:id="@+id/imdbRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.0/10" android:textColor="#FFFFFFFF" android:textSize="25sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Metacritic" android:textColor="#F4EAF5" android:textSize="12sp"/><TextView android:id="@+id/metacriticRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="83/100" android:textColor="#FFFFFFFF" android:textSize="25sp" android:textStyle="bold"/></LinearLayout>
    </LinearLayout>
 </LinearLayout>
</ScrollView>
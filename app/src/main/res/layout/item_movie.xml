<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/movieCard" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/bg_movie_blue" android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="54dp" android:layout_height="76dp" android:background="@drawable/bg_poster">
        <TextView android:id="@+id/posterInitial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="MF" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/movieTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Movie title" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/movieType" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Movie" android:textColor="#EFFFFFFF" android:textSize="12sp" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_star" android:contentDescription="Рейтинг"/>
        <TextView android:id="@+id/movieRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.6" android:textColor="#FFFFFFFF" android:textSize="13sp" android:layout_marginStart="3dp"/>
    </LinearLayout>
</LinearLayout>